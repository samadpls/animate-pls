# renders and intermediates are rebuilt by the tools
**/frames/
**/renders/
**/review/*-vs-ref.*
node_modules/
__pycache__/
# built files (tools/build.mjs makes them from src/ + kit/ + the style)
plugins/**/index.html
plugins/**/review/
# README gallery tiles: only the sources are kept (docs/gallery/build.mjs renders the rest)
docs/gallery/*/index.html
docs/gallery/*/review/
docs/gallery/*/thumb.png
